@@ -197,7 +198,53 @@ enum Output<W> {
 enum CandidateBuffer {
     Inactive,
     Memory(Vec<u8>),
-    File { file: File, len: u64 },
+    File { file: SpoolFile, len: u64 },
+}
+
+// A bounded staging buffer avoids one filesystem write per formatting fragment.
+// Discard/drop intentionally abandon pending bytes instead of BufWriter's
+// best-effort flush, so invalid candidates never trigger extra spool writes.
+const SPOOL_BUFFER_BYTES: usize = 64 * 1024;
+
+struct SpoolFile {
+    writer: Option<BufWriter<File>>,
+}
+
+impl SpoolFile {
+    fn new(file: File) -> Self {
+        Self {
+            writer: Some(BufWriter::with_capacity(SPOOL_BUFFER_BYTES, file)),
+        }
+    }
+
+    fn write_all(&mut self, bytes: &[u8]) -> io::Result<()> {
+        self.writer.as_mut().unwrap().write_all(bytes)
+    }
+
+    fn commit(mut self, destination: &mut impl Write) -> io::Result<()> {
+        let writer = self.writer.as_mut().unwrap();
+        // Surface delayed storage errors before releasing any candidate bytes.
+        writer.flush()?;
+        let file = writer.get_mut();
+        file.rewind()?;
+        io::copy(file, destination)?;
+        Ok(())
+    }
+
+    #[cfg(test)]
+    fn metadata(&self) -> io::Result<std::fs::Metadata> {
+        self.writer.as_ref().unwrap().get_ref().metadata()
+    }
+}
+
+impl Drop for SpoolFile {
+    fn drop(&mut self) {
+        if let Some(writer) = self.writer.take() {
+            // into_parts does not flush. Dropping the returned File releases
+            // the private temporary file on success, discard and every error.
+            let _ = writer.into_parts();
+        }
+    }
 }
 
