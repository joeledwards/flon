+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq, clap::ValueEnum)]
+pub(super) enum SummaryFormat {
+    #[default]
+    Text,
+    Json,
+    Flon,
+}
+
 pub(super) fn run(
     enabled: bool,
     mut diagnostics: impl Write,
