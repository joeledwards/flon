+#[cfg(test)]
 fn write_summary(
+    output: impl Write,
+    elapsed: Duration,
+    result: &io::Result<()>,
+    metrics: &Metrics,
+    styled: bool,
+) -> io::Result<()> {
+    write_formatted_summary(
+        output,
+        elapsed,
+        result,
+        metrics,
+        styled,
+        SummaryFormat::Text,
+    )
+}
+
+// Human quantities are approximate; literal integer fields never pass through f64.
+fn quantity(value: f64, units: &[&str], base: f64) -> String {
+    let mut scaled = value;
+    let mut unit = 0;
+    while scaled >= base && unit + 1 < units.len() {
+        scaled /= base;
+        unit += 1;
+    }
+    format!("{scaled:.2} {}", units[unit]).trim_end().to_owned()
+}
+
+struct Field {
+    name: &'static str,
+    label: &'static str,
+    literal: String,
+    readable: String,
+}
